# Local Ollama on a GPU host (e.g. RTX 3060 12GB VRAM)
# Option A: Via SSH tunnel from Mac (no firewall changes needed):
#   ssh -fN -L 11434:127.0.0.1:11434 <gpu-host>
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Option B: Direct over LAN/Tailscale (if OLLAMA_HOST=0.0.0.0 + Firewall TCP 11434 enabled):
# LLM_BASE_URL=http://<gpu-host>:11434/v1

LLM_API_KEY=ollama

# 12GB VRAM RTX 3060 pair matching the official LongMemEval-V2 paper's Qwen3.5 / Qwen3-Embedding family:
# - qwen3.5:9b (Q4_K_M ~6.0GB VRAM, natively multimodal, hybrid linear-attention KV cache)
# - qwen3-embedding:0.6b (~0.64GB VRAM, 32K context)
# Both stay co-resident in 12GB VRAM (~6.7GB weights) with room for long AXTree contexts.
# Optional HuggingFace dynamic quant: hf.co/unsloth/Qwen3.5-9B-GGUF:UD-Q4_K_XL
MEMDIFF_CHAT_MODEL=qwen3.5:9b
MEMDIFF_EMBEDDING_MODEL=qwen3-embedding:0.6b
MEMDIFF_JUDGE_MODEL=qwen3.5:9b

# Optional: switch to OpenAI cloud anytime by uncommenting:
# LLM_BASE_URL=
# OPENAI_API_KEY=sk-your-key-here
# MEMDIFF_CHAT_MODEL=gpt-4o-mini
# MEMDIFF_EMBEDDING_MODEL=text-embedding-3-small
# MEMDIFF_JUDGE_MODEL=gpt-4o-mini

# Data & cache paths
MEMDIFF_DATA_DIR=data/longmemeval-v2
MEMDIFF_CACHE_DIR=.cache/llm
